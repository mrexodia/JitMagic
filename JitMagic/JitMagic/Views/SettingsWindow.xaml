<Window x:Class="JitMagic.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JitMagic"
        xmlns:vm="clr-namespace:JitMagic.ViewModels"
        mc:Ignorable="d"
        Title="Settings" Height="800" Width="700"  WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    
    <d:Window.DataContext>
        <vm:SettingsViewModel/>
    </d:Window.DataContext>
	<Window.Resources>
		<Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource DefaultGroupBoxStyle}">
            <Setter Property="Margin" Value="1,2"/>
            <Setter Property="Padding" Value="6,4,6,5"/>
			<Setter Property="HeaderTemplate">
				<Setter.Value>
					<DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="14" FontWeight="Bold"/>
					</DataTemplate>
				</Setter.Value>
			</Setter>
		</Style>
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Margin" Value="2"/>
			<Setter Property="Padding" Value="2,1"/>
		</Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="Margin" Value="2"/>
			<Setter Property="Padding" Value="3,1"/>
		</Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
            <Setter Property="Margin" Value="2"/>
			<Setter Property="Padding" Value="2,1"/>
		</Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
			<Setter Property="MinWidth" Value="0"/>
			<Setter Property="Margin" Value="1,2"/>
        </Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="1,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
	</Window.Resources>
	
	<Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4">

                <!-- General Theme -->
                <GroupBox Header="Appearance">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Theme:" Margin="0,0,10,0"/>
                        <ComboBox SelectedValue="{Binding ForcedTheme}" SelectedValuePath="Tag" Width="150" HorizontalAlignment="Left">
                            <ComboBoxItem Content="System (Default)" Tag="{x:Null}"/>
                            <ComboBoxItem Content="Light" Tag="Light"/>
                            <ComboBoxItem Content="Dark" Tag="Dark"/>
                        </ComboBox>
                    </StackPanel>
                </GroupBox>

                <!-- Blacklisted Paths -->
                <GroupBox Header="Blacklisted">
                    <Grid Height="250">
                        <Grid.RowDefinitions>
							
							<RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
						<StackPanel Orientation="Horizontal">
							<Label VerticalAlignment="Center" Content="Ignore target if has side by side file with this extension&#x0a;(ie .nojit means if YourExec.nojit exists ignore it): " HorizontalContentAlignment="Right" />
							<TextBox Text="{Binding IgnoreProcessesWithSideBySideFileExtension}" Width="100"  />
						</StackPanel>
						<ListBox ItemsSource="{Binding BlacklistedPaths}" SelectedItem="{Binding SelectedBlacklistPath}" Grid.Row="1">
							<ListBox.ItemContainerStyle>
								<Style TargetType="ListBoxItem"  BasedOn="{StaticResource DefaultListBoxItemStyle}">
									<Setter Property="Padding" Value="0"/>
									<Setter Property="Margin" Value="2,2,2,0" />
								</Style>
							</ListBox.ItemContainerStyle>
						</ListBox>
						<Button Grid.Row="2" Content="Remove Selected Path" Command="{Binding RemoveBlacklistItemCmd}" HorizontalAlignment="Right" />
                    </Grid>
                </GroupBox>

                <!-- Capture Output -->
                <GroupBox Header="Capture Debugger Output">
					<StackPanel>
						<TextBlock Text="Captures the stdout/err from the debugger process selected and saved to a file for diagnostics" />
						<Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding CaptureDebuggerOutputTo, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="..." Command="{Binding BrowseCaptureFileCmd}" Width="30"/>
                    </Grid>
					</StackPanel>
				</GroupBox>

                <!-- Behavior -->
                <GroupBox Header="Behavior">
                    <StackPanel>
                        <CheckBox Content="Perform registered check on startup" IsChecked="{Binding PerformRegisteredCheckOnStart}"/>
                        <CheckBox Content="Don't kill target process on non-debug exit" IsChecked="{Binding DontKillTargetProcessOnNonDebugExit}"/>
                        <CheckBox Content="Don't kill blacklisted processes" IsChecked="{Binding DontKillBlacklistedProcesses}"/>
                    </StackPanel>
                </GroupBox>

                <!-- Timing -->
                <GroupBox Header="Timing &amp; Auto-Close">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Default ignore duration (minutes):" />
                        <TextBox Grid.Column="1" Text="{Binding DefaultIgnoreMinutes}" Width="60" HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="1" Text="Auto-close after process exit (seconds):" />
						<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OnProcDieAutoCloseAfterSecs, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}"  Width="60" HorizontalAlignment="Left"/>
                    </Grid>
                </GroupBox>

                <!-- Window Size Override -->
                <GroupBox Header="Window Size Override (0 for default)">
					<StackPanel Orientation="Horizontal">
                        <TextBlock Text="Width:" />
						<TextBox Grid.Column="1" Text="{Binding OverrideWidth}"  Width="80"  />

                        <TextBlock Grid.Column="2" Text="Height:" />
						<TextBox Grid.Column="3" Text="{Binding OverrideHeight}"  Width="80" />
					</StackPanel>
				</GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" >
            <Button Content="Save" Command="{Binding SaveCmd}" IsDefault="True" Width="80" />
            <Button Content="Cancel" Command="{Binding CancelCmd}" IsCancel="True" Width="80"/>
        </StackPanel>
    </Grid>
</Window>
