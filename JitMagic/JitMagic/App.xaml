<Application x:Class="JitMagic.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:JitMagic"
			 xmlns:views="clr-namespace:JitMagic.Views"
             StartupUri="Views/JITSelectorWindow.xaml">
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<views:BoolVisibilityConverter x:Key="boolVisibilityConverter" />
		</ResourceDictionary>
		
	</Application.Resources>
</Application>
